{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "migraine-log",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "migraine-log",
      "database_id": "143e1367-c685-449c-b15d-cd592067942a",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [
    { "name": "AI_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "WEATHER_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
    { "name": "SYNC_LIMITER", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": { "crons": ["5 * * * *"] },
  "vars": {
    "VAPID_PUBLIC_KEY": "BB2pyypdozdza6rhZzOrxnLS6m-fU3qbBeEc58CDjX6TmSkYESQBkt8qcGFro8pIxrTgZyaU5kCj3QRQRdVVnDg",
    "GOOGLE_CLIENT_ID": "674715201485-v8pugkcd7a0sc6tflormd7p9mss7j8u7.apps.googleusercontent.com",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
}
