{
  "name": "migraine-log",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "preview": "vite build && vite preview",
    "db:migrate:local": "wrangler d1 migrations apply migraine-log --local",
